---
import { SITE } from "../../config/site";
---

<header class="border-b border-border">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <a href="/" class="text-lg font-bold tracking-tight">{SITE.name}</a>

    <button
      id="theme-toggle"
      type="button"
      class="rounded-md border border-border p-2 text-muted transition-colors hover:text-fg"
      aria-label="テーマを切り替える"
    >
      {/* ライト時は月（ダークへ）、ダーク時は太陽（ライトへ）を表示 */}
      <svg
        class="block size-5 dark:hidden"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg
        class="hidden size-5 dark:block"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
        ></path>
      </svg>
    </button>
  </div>
</header>

<script>
  import { THEME_STORAGE_KEY, nextTheme } from "../../lib/theme";

  const btn = document.getElementById("theme-toggle");
  btn?.addEventListener("click", () => {
    const el = document.documentElement;
    const next = nextTheme(el.dataset.theme);
    el.dataset.theme = next;
    try {
      localStorage.setItem(THEME_STORAGE_KEY, next);
    } catch {
      /* localStorage が使えない環境では保存しない */
    }
  });
</script>
