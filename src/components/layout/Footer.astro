---
import { SITE } from "../../config/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>
      © {year} {SITE.name}
    </p>
    <nav class="flex gap-4">
      <a href="/privacy" class="transition-colors hover:text-fg">
        プライバシーポリシー
      </a>
    </nav>
  </div>
</footer>
